{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alacritty Config UI",
  "version": "0.1.0",
  "identifier": "io.github.dev2019zheng.alacritty-config-ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Alacritty Config UI",
        "width": 1480,
        "height": 940,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["../assets/app-icon.icns", "../assets/app-icon.png"],
    "resources": {
      "../vendor/alacritty-theme/themes": "themes",
      "../LICENSE-APACHE": "LICENSE-APACHE",
      "../LICENSE-MIT": "LICENSE-MIT"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
